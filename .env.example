DOMAIN=localhost
FRONTEND_PORT=3000
DB_PASSWORD=parcelstats
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:${FRONTEND_PORT}
# Shared secret between the frontend and the ML service (generate with: openssl rand -hex 32)
INTERNAL_API_KEY=

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, type Web)
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get access to /admin
ADMIN_EMAILS=
MODEL_RETRAIN_SCHEDULE=0 3 * * 0

POLL_INTERVAL_ACTIVE=1800
POLL_INTERVAL_TRANSIT=1800
POLL_INTERVAL_PENDING=7200
POLL_INTERVAL_OTHERS=14400
POLL_MAX_SHIPMENTS=50
POLL_CHECK_INTERVAL=300

USPS_WEB_TOOLS_USER_ID=

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_MERCHANT_ID=
UPS_BASE_URL=https://onlinetools.ups.com
UPS_TRANSACTION_SRC=ParcelStats

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_BASE_URL=https://apis.fedex.com
FEDEX_LOCALE=en_US
